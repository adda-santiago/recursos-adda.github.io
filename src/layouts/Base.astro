---
import '../styles/tokens.css';
import '../styles/global.css';
import { SITIO } from '../config/sitio';
import { ruta } from '../lib/url';
import versiones from '../../public/biblia/versiones.json';

interface Props {
  titulo: string;
  descripcion?: string;
  noindex?: boolean;
  canonical?: string;
  embed?: boolean;           // página /embed/: sin cabecera, sin pie, sin anuncios
}
const { titulo, descripcion = SITIO.descripcion, noindex = false, canonical, embed = false } = Astro.props;
const tituloCompleto = titulo === SITIO.nombre ? titulo : `${titulo} · ${SITIO.nombre}`;
const urlCanonica = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang={SITIO.idioma} class={embed ? 'embed' : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={urlCanonica} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={urlCanonica} />
  <meta name="theme-color" content="#fafaf8" />
  <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>${SITIO.emoji}</text></svg>`)}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  {SITIO.analitica.goatcounter && (
    <script is:inline async data-goatcounter={SITIO.analitica.goatcounter} src="//gc.zgo.at/count.js"></script>
  )}
  <slot name="head" />
</head>
<body>
  {!embed && (
    <header class="top no-citas">
      <a class="brand" href={ruta()}>
        <span class="brand-marca" aria-hidden="true">
          {SITIO.logo ? <img src={ruta(SITIO.logo)} alt="" width="44" height="44" /> : SITIO.emoji}
        </span>
        <span class="brand-nombre">{SITIO.nombre}</span>
      </a>
      <form class="buscador" role="search" action={ruta()} data-buscador>
        <label for="q" class="visually-hidden">Buscar un recurso</label>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input id="q" name="q" type="search" autocomplete="off" enterkeyhint="search"
          placeholder="Buscar: tabernáculo, reyes de Judá, Pablo…" />
      </form>
      <nav aria-label="Principal">
        <label class="version-biblia" title="Versión de la Biblia para las citas">
          <span class="visually-hidden">Versión de la Biblia</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"/><path d="M5 17a3 3 0 0 1 3-3h11"/></svg>
          <select data-version-biblia>
            {versiones.map(v => <option value={v.id} selected={v.defecto}>{v.abrev}</option>)}
          </select>
        </label>
        <a href={ruta('buzon/')}>Sugerencias</a>
      </nav>
    </header>
  )}
  <slot />
  {!embed && (
    <footer class="pie">
      <span>{SITIO.nombre}</span>
      <a href={ruta('buzon/')}>Enviar una sugerencia o reportar un error</a>
      <a href={ruta('privacidad/')}>Privacidad</a>
    </footer>
  )}
  {!embed && (
    <script>
      import { iniciarAnuncios } from '../lib/anuncios';
      iniciarAnuncios();
    </script>
  )}
  {!embed && (
    <script>
      // Versión de la Biblia: la misma preferencia que usa la burbuja de citas en las apps (citas.js)
      import { almacen } from '../lib/storage';
      const sel = document.querySelector<HTMLSelectElement>('[data-version-biblia]');
      if (sel) {
        const actual = almacen.versionBiblia();
        if (actual && [...sel.options].some(o => o.value === actual)) sel.value = actual;
        sel.addEventListener('change', () => {
          almacen.cambiarVersionBiblia(sel.value);
          // citas.js de esta página escucha este evento; las apps en iframe reciben el evento «storage»
          (window as any).Citas?.cambiarVersion?.(sel.value);
        });
        window.addEventListener('citas:version', e => { sel.value = (e as CustomEvent).detail; });
      }
    </script>
  )}
  {/* Citas bíblicas en burbuja también en las fichas y páginas del sitio (DIRECTRICES §15) */}
  <script is:inline define:vars={{ biblia: ruta('biblia/') }}>window.CITAS_BIBLIA = biblia;</script>
  <script is:inline src={ruta('apps/assets/js/citas.js')} defer></script>
</body>
</html>
