---
import type { CollectionEntry } from 'astro:content';
import { ASIGNATURAS, COLECCIONES, NIVELES, TIPOS } from '../data/taxonomia';
import { rutaRecurso } from '../lib/url';
interface Props { r: CollectionEntry<'recursos'>; }
const { r } = Astro.props;
const d = r.data;
---
<li data-uid={d.uid} data-asignatura={d.asignatura} data-tipo={d.tipo} data-niveles={d.niveles.join(' ')} data-tags={d.tags.join(' ')} data-coleccion={d.coleccion ?? ''}>
  <a class="item" href={rutaRecurso(d.asignatura, r.id)}>
    <span class="emoji" aria-hidden="true">{d.emoji}</span>
    <span><h3>{d.titulo}</h3></span>
    <p>{d.resumen}</p>
    <span class="meta">
      <span class="chip">{TIPOS[d.tipo]}</span>
      <span class="chip">{ASIGNATURAS[d.asignatura]}</span>
      {d.coleccion && <span class="chip">{COLECCIONES[d.coleccion]}</span>}
      {d.niveles.map((n) => <span class="chip">{NIVELES[n]}</span>)}
    </span>
  </a>
</li>
