---
/* Tarjeta de recurso para la portada. Los data-* alimentan los filtros
   del lado del navegador; el HTML completo queda en la página para SEO
   y para quien navegue sin JavaScript. */
import type { CollectionEntry } from 'astro:content';
import { EPOCAS, TESTAMENTOS, TIPOS } from '../data/taxonomia';
import { ruta, rutaRecurso } from '../lib/url';
interface Props { r: CollectionEntry<'recursos'>; destacada?: boolean; }
const { r, destacada = false } = Astro.props;
const d = r.data;
// Épocas: si son muchas (recursos transversales) se muestra el rango
const epocas = d.epocas.length > 2
  ? `${EPOCAS[d.epocas[0]]} – ${EPOCAS[d.epocas[d.epocas.length - 1]]}`
  : d.epocas.map((e) => EPOCAS[e]).join(' · ');
---
<li
  class:list={['tarjeta-item', { destacada }]}
  data-uid={d.uid}
  data-testamento={d.testamento.join(' ')}
  data-libro={d.libros.join(' ')}
  data-epoca={d.epocas.join(' ')}
  data-tipo={d.tipo}
  data-tag={d.tags.join(' ')}
  data-orden={d.orden}
>
  <a class="tarjeta" href={rutaRecurso(r.id)}>
    <span class="tarjeta-imagen" aria-hidden="true">
      {d.imagen
        ? <img src={ruta(d.imagen.replace(/\.webp$/, '-640.webp'))}
               srcset={`${ruta(d.imagen.replace(/\.webp$/, '-640.webp'))} 640w, ${ruta(d.imagen)} 1200w`}
               sizes="(max-width: 720px) 40vw, 400px" width="640" height="360" alt="" loading="lazy" decoding="async" />
        : d.visor.poster
          ? <img src={d.visor.poster} alt="" loading="lazy" decoding="async" />
          : <span class="tarjeta-emoji">{d.emoji}</span>}
      <span class="tarjeta-tipo">{TIPOS[d.tipo]}</span>
    </span>
    <span class="tarjeta-cuerpo">
      <span class="tarjeta-seccion">
        {d.testamento.map((t) => TESTAMENTOS[t]).join(' · ')}
      </span>
      <h3>{d.titulo}</h3>
      <span class="tarjeta-resumen">{d.resumen}</span>
      {epocas && <span class="tarjeta-niveles">{epocas}</span>}
    </span>
  </a>
</li>
