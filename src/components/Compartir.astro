---
interface Props { titulo: string; url: string; embed: string; }
const { titulo, url, embed } = Astro.props;
const texto = `${titulo}: ${url}`;
const idCampo = `embed-${embed.replace(/[^a-z0-9]+/gi, "-")}`;
const codigo = `<iframe src="${embed}" title="${titulo}" width="100%" height="560" style="border:0" allow="fullscreen" allowfullscreen loading="lazy"></iframe>`;
---
<dialog class="compartir" data-compartir data-url={url} data-titulo={titulo}>
  <button type="button" class="cerrar" data-cerrar aria-label="Cerrar">✕</button>
  <h2>Compartir</h2>
  <div class="opciones">
    <button type="button" data-copiar={url}>Copiar enlace</button>
    <button type="button" data-nativo hidden>Más opciones…</button>
    <a href={`https://wa.me/?text=${encodeURIComponent(texto)}`} target="_blank" rel="noopener">WhatsApp</a>
    <a href={`https://classroom.google.com/share?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">Google Classroom</a>
    <a href={`https://teams.microsoft.com/share?href=${encodeURIComponent(url)}&msgText=${encodeURIComponent(titulo)}`} target="_blank" rel="noopener">Microsoft Teams</a>
  </div>
  <label for={idCampo}>Insertar en Classroom, Moodle o un blog</label>
  <textarea id={idCampo} rows="4" readonly>{codigo}</textarea>
  <div class="opciones" style="margin-top:.5rem">
    <button type="button" data-copiar={codigo} data-es-embed>Copiar código</button>
  </div>
  <p class="aviso" data-aviso aria-live="polite"></p>
</dialog>

<script>
  import { registrar } from '../lib/analitica';
  document.querySelectorAll<HTMLDialogElement>('[data-compartir]').forEach((d) => {
    const aviso = d.querySelector<HTMLElement>('[data-aviso]')!;
    const nativo = d.querySelector<HTMLButtonElement>('[data-nativo]')!;
    d.querySelector('[data-cerrar]')!.addEventListener('click', () => d.close());
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
    d.addEventListener('close', () => { aviso.textContent = ''; });

    d.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) => {
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copiar!);
          aviso.textContent = b.dataset.esEmbed !== undefined ? 'Código copiado.' : 'Enlace copiado.';
        } catch {
          aviso.textContent = 'No se pudo copiar. Selecciona el texto y cópialo manualmente.';
        }
        registrar(b.dataset.esEmbed !== undefined ? 'copiar-embed' : 'compartir', 'copiar');
      });
    });
    d.querySelectorAll<HTMLAnchorElement>('.opciones a').forEach((a) =>
      a.addEventListener('click', () => registrar('compartir', a.textContent!.trim().toLowerCase().replace(/\s+/g, '-'))));

    if (navigator.share) {
      nativo.hidden = false;
      nativo.addEventListener('click', () => {
        navigator.share({ title: d.dataset.titulo, url: d.dataset.url }).catch(() => {});
        registrar('compartir', 'nativo');
      });
    }
  });
</script>
