---
/*
 * Redirecciones de las URL antiguas /{asignatura}/{slug}/ a /{slug}/ (DIRECTRICES §5).
 * Hasta la v2.0 las fichas vivían bajo /religion/; GitHub Pages no permite
 * redirecciones 301, así que cada URL antigua es una página que reenvía.
 */
import { getCollection } from 'astro:content';
import { rutaRecurso } from '../../lib/url';

export async function getStaticPaths() {
  const recursos = await getCollection('recursos', (r) => r.data.publicado);
  return recursos.map((r) => ({ params: { asignatura: 'religion', slug: r.id }, props: { slug: r.id } }));
}
const { slug } = Astro.props;
const destino = rutaRecurso(slug);
const canonica = new URL(destino, Astro.site).href;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Redirigiendo…</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={canonica} />
  <meta http-equiv="refresh" content={`0; url=${destino}`} />
  <script is:inline define:vars={{ destino }}>location.replace(destino + location.search + location.hash);</script>
</head>
<body><p><a href={destino}>Ir al recurso</a></p></body>
</html>
