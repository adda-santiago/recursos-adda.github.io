---
/*
 * Portada = buscador + catálogo completo.
 * - El buscador vive en la cabecera (Base.astro) y aquí filtra en vivo.
 * - Sin búsqueda, el catálogo se filtra por sección, colección, tipo, nivel y etiquetas.
 * - "Recién agregados" aparece entre la cabecera y el catálogo, y se oculta
 *   mientras hay búsqueda o filtros activos para que los resultados queden arriba.
 * Estado en la URL: ?q=&seccion=&coleccion=&tipo=&nivel=&tag=&guardados=1
 * (valores múltiples separados por coma).
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TarjetaRecurso from '../components/TarjetaRecurso.astro';
import EspacioAnuncio from '../components/EspacioAnuncio.astro';
import { SITIO } from '../config/sitio';
import { ASIGNATURAS, COLECCIONES, NIVELES, TIPOS } from '../data/taxonomia';
import { ruta, rutaRecurso } from '../lib/url';

const recursos = (await getCollection('recursos', (r) => r.data.publicado))
  .sort((a, b) => a.data.orden - b.data.orden);

const MAX_RECIENTES = 4;
const recientes = [...recursos]
  .sort((a, b) => b.data.fechaPublicacion.getTime() - a.data.fechaPublicacion.getTime() || a.data.orden - b.data.orden)
  .slice(0, MAX_RECIENTES);

// Opciones de cada faceta: solo valores que algún recurso usa, en el orden de la taxonomía
function opciones<K extends string>(etiquetas: Record<K, string>, usados: string[]) {
  return (Object.keys(etiquetas) as K[]).filter((k) => usados.includes(k)).map((k) => ({ valor: k, nombre: etiquetas[k] }));
}
const contarTags = new Map<string, number>();
recursos.forEach((r) => r.data.tags.forEach((t) => contarTags.set(t, (contarTags.get(t) ?? 0) + 1)));
const tags = [...contarTags.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([t]) => ({ valor: t, nombre: `#${t}` }));

const facetas = [
  { clave: 'seccion', titulo: 'Sección', items: opciones(ASIGNATURAS, recursos.map((r) => r.data.asignatura)) },
  { clave: 'coleccion', titulo: 'Colección', items: opciones(COLECCIONES, recursos.map((r) => r.data.coleccion ?? '')) },
  { clave: 'tipo', titulo: 'Tipo de recurso', items: opciones(TIPOS, recursos.map((r) => r.data.tipo)) },
  { clave: 'nivel', titulo: 'Nivel', items: opciones(NIVELES, recursos.flatMap((r) => r.data.niveles)) },
  { clave: 'tag', titulo: 'Etiquetas', items: tags },
].filter((f) => f.items.length > 0);

const VISIBLES_TAGS = 8;

// Catálogo liviano para la búsqueda de respaldo (sin Pagefind, p. ej. en `npm run dev`)
const catalogo = recursos.map((r) => ({
  uid: r.data.uid,
  u: rutaRecurso(r.data.asignatura, r.id),
  k: [r.data.titulo, r.data.resumen, ASIGNATURAS[r.data.asignatura], TIPOS[r.data.tipo],
      r.data.coleccion ? COLECCIONES[r.data.coleccion] : '', ...r.data.tags].join(' '),
}));
---
<Base titulo={SITIO.nombre}>
  <main class="inicio" data-inicio>
    <section class="recientes" data-recientes aria-labelledby="titulo-recientes">
      <h2 id="titulo-recientes" class="titulo-bloque">Recién agregados</h2>
      <ul class="rejilla rejilla-recientes">
        {recientes.map((r) => <TarjetaRecurso r={r} destacada />)}
      </ul>
    </section>

    <div class="catalogo">
      <details class="panel-filtros" data-panel-filtros open>
        <summary>Filtros <span class="contador-filtros" data-contador-filtros></span></summary>
        <div class="filtros-cuerpo">
          <div class="filtros-cabecera">
            <h2 class="titulo-bloque">Filtrar</h2>
            <button type="button" class="limpiar" data-limpiar hidden>Limpiar</button>
          </div>

          <fieldset class="faceta" data-guardados-faceta hidden>
            <label class="opcion">
              <input type="checkbox" data-solo-guardados />
              <span>Solo mis guardados</span>
              <span class="cuenta" data-cuenta-guardados></span>
            </label>
          </fieldset>

          {facetas.map((f) => (
            <fieldset class="faceta" data-faceta={f.clave}>
              <legend>{f.titulo}</legend>
              {f.items.map((o, i) => (
                <label class="opcion" hidden={f.clave === 'tag' && i >= VISIBLES_TAGS ? true : undefined} data-extra={f.clave === 'tag' && i >= VISIBLES_TAGS ? '' : undefined}>
                  <input type="checkbox" value={o.valor} />
                  <span>{o.nombre}</span>
                  <span class="cuenta" data-cuenta></span>
                </label>
              ))}
              {f.clave === 'tag' && f.items.length > VISIBLES_TAGS && (
                <button type="button" class="ver-mas" data-ver-mas>Ver {f.items.length - VISIBLES_TAGS} más</button>
              )}
            </fieldset>
          ))}
          <EspacioAnuncio slot="inicio-lateral" />
        </div>
      </details>

      <section class="panel-resultados" aria-labelledby="titulo-catalogo">
        <div class="resultados-cabecera">
          <h2 id="titulo-catalogo" class="titulo-bloque" data-titulo-catalogo>Todos los recursos</h2>
          <p class="conteo" data-conteo aria-live="polite">{recursos.length} recursos</p>
        </div>
        <ul class="rejilla" data-rejilla>
          {recursos.map((r) => <TarjetaRecurso r={r} />)}
        </ul>
        <div class="sin-resultados" data-vacio hidden>
          <p data-vacio-texto>Ningún recurso cumple esos criterios.</p>
          <p>
            <a href={ruta('buzon/')} data-pedir>Pide que lo agreguemos</a> o
            <button type="button" class="enlace" data-limpiar>quita los filtros</button>.
          </p>
        </div>
        <EspacioAnuncio slot="inicio-final" />
      </section>
    </div>
  </main>

  <script is:inline type="application/json" id="catalogo" set:html={JSON.stringify(catalogo)} />
  <script is:inline define:vars={{ base: ruta(), buzon: ruta('buzon/') }}>
    window.__AV = { base, buzon };
  </script>
</Base>

<script>
  import { almacen } from '../lib/storage';
  import { registrar } from '../lib/analitica';

  type Item = { uid: string; u: string; k: string };
  const catalogo: Item[] = JSON.parse(document.getElementById('catalogo')!.textContent!);
  const { base, buzon } = (window as any).__AV as { base: string; buzon: string };

  const norm = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  const CLAVES = ['seccion', 'coleccion', 'tipo', 'nivel', 'tag'] as const;
  type Clave = (typeof CLAVES)[number];

  const form = document.querySelector<HTMLFormElement>('[data-buscador]')!;
  const input = form.querySelector('input')!;
  const recientes = document.querySelector<HTMLElement>('[data-recientes]')!;
  const tarjetas = [...document.querySelectorAll<HTMLElement>('[data-rejilla] > li')];
  const conteo = document.querySelector<HTMLElement>('[data-conteo]')!;
  const tituloCatalogo = document.querySelector<HTMLElement>('[data-titulo-catalogo]')!;
  const vacio = document.querySelector<HTMLElement>('[data-vacio]')!;
  const vacioTexto = document.querySelector<HTMLElement>('[data-vacio-texto]')!;
  const pedir = document.querySelector<HTMLAnchorElement>('[data-pedir]')!;
  const panel = document.querySelector<HTMLDetailsElement>('[data-panel-filtros]')!;
  const contadorFiltros = document.querySelector<HTMLElement>('[data-contador-filtros]')!;
  const botonesLimpiar = document.querySelectorAll<HTMLButtonElement>('[data-limpiar]');
  const soloGuardados = document.querySelector<HTMLInputElement>('[data-solo-guardados]')!;

  // ---------- Estado ----------
  const estado = {
    q: '',
    filtros: Object.fromEntries(CLAVES.map((c) => [c, new Set<string>()])) as Record<Clave, Set<string>>,
    guardados: false,
  };
  let favoritos = new Set<string>();
  let coincidencias: string[] | null = null; // uids que cumplen la búsqueda, en orden de relevancia

  function leerURL() {
    const p = new URLSearchParams(location.search);
    estado.q = p.get('q') ?? '';
    for (const c of CLAVES) estado.filtros[c] = new Set((p.get(c) ?? '').split(',').filter(Boolean));
    estado.guardados = p.get('guardados') === '1';
  }
  function escribirURL() {
    const p = new URLSearchParams();
    if (estado.q.trim()) p.set('q', estado.q.trim());
    for (const c of CLAVES) if (estado.filtros[c].size) p.set(c, [...estado.filtros[c]].join(','));
    if (estado.guardados) p.set('guardados', '1');
    const qs = p.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  // ---------- Búsqueda (Pagefind tras el build; catálogo local como respaldo) ----------
  let pagefind: any = null;
  const cargarPagefind = (async () => {
    try {
      pagefind = await import(/* @vite-ignore */ `${base}pagefind/pagefind.js`);
      await pagefind.options?.({ baseUrl: base });
    } catch { pagefind = null; }
  })();

  async function buscar(q: string): Promise<string[]> {
    const terminos = norm(q).split(/\s+/).filter(Boolean);
    await cargarPagefind;
    if (pagefind) {
      const r = await pagefind.search(q);
      const datos = await Promise.all(r.results.slice(0, 50).map((x: any) => x.data()));
      // Pagefind tolera coincidencias parciales: exigimos cada término por su raíz
      const raices = terminos.map((t) => t.slice(0, Math.max(3, Math.min(t.length, 5))));
      return datos
        .filter((x: any) => { const txt = norm(`${x.meta.title} ${x.content}`); return raices.every((t) => txt.includes(t)); })
        .map((x: any) => x.meta.uid)
        .filter(Boolean);
    }
    return catalogo.filter((i) => terminos.every((t) => norm(i.k).includes(t))).map((i) => i.uid);
  }

  // ---------- Filtro ----------
  function cumple(li: HTMLElement, excepto?: Clave): boolean {
    const uid = li.dataset.uid!;
    if (coincidencias && !coincidencias.includes(uid)) return false;
    if (estado.guardados && !favoritos.has(uid)) return false;
    for (const c of CLAVES) {
      if (c === excepto) continue;
      const elegidos = estado.filtros[c];
      if (!elegidos.size) continue;
      const valores = (li.dataset[c] ?? '').split(' ').filter(Boolean);
      if (!valores.some((v) => elegidos.has(v))) return false; // O dentro de una faceta, Y entre facetas
    }
    return true;
  }

  function pintar() {
    const hayFiltros = CLAVES.some((c) => estado.filtros[c].size) || estado.guardados;
    const hayBusqueda = !!coincidencias;

    let n = 0;
    tarjetas.forEach((li) => {
      const ok = cumple(li);
      li.hidden = !ok;
      if (ok) n++;
      // Con búsqueda, se ordena por relevancia; sin ella, por el orden editorial
      li.style.order = hayBusqueda ? String(coincidencias!.indexOf(li.dataset.uid!)) : '';
    });

    // Conteos por opción, considerando todo lo demás que está activo
    document.querySelectorAll<HTMLElement>('[data-faceta]').forEach((fs) => {
      const clave = fs.dataset.faceta as Clave;
      fs.querySelectorAll<HTMLLabelElement>('.opcion').forEach((lab) => {
        const cb = lab.querySelector('input')!;
        cb.checked = estado.filtros[clave].has(cb.value);
        const total = tarjetas.filter((li) => cumple(li, clave) && (li.dataset[clave] ?? '').split(' ').includes(cb.value)).length;
        lab.querySelector<HTMLElement>('[data-cuenta]')!.textContent = String(total);
        lab.classList.toggle('vacia', total === 0 && !cb.checked);
      });
    });
    soloGuardados.checked = estado.guardados;

    recientes.hidden = hayFiltros || hayBusqueda;
    tituloCatalogo.textContent = hayBusqueda ? `Resultados para «${estado.q.trim()}»` : hayFiltros ? 'Recursos filtrados' : 'Todos los recursos';
    conteo.textContent = `${n} recurso${n === 1 ? '' : 's'}`;
    vacio.hidden = n > 0;
    if (!n) {
      vacioTexto.innerHTML = hayBusqueda
        ? `No hay recursos para «${esc(estado.q.trim())}»${hayFiltros ? ' con esos filtros' : ''} todavía.`
        : 'Ningún recurso cumple esos filtros.';
      pedir.href = hayBusqueda ? `${buzon}?q=${encodeURIComponent(estado.q.trim())}` : buzon;
    }
    const activos = CLAVES.reduce((s, c) => s + estado.filtros[c].size, 0) + (estado.guardados ? 1 : 0);
    contadorFiltros.textContent = activos ? `(${activos})` : '';
    botonesLimpiar.forEach((b) => { if (b.closest('.filtros-cabecera')) b.hidden = !activos && !hayBusqueda; });
    escribirURL();
  }

  let turno = 0;
  async function actualizarBusqueda() {
    const mio = ++turno;
    const q = estado.q.trim();
    if (!q) { coincidencias = null; pintar(); return; }
    const res = await buscar(q);
    if (mio !== turno) return;
    coincidencias = res;
    registrar(res.length ? 'busqueda' : 'busqueda-sin-resultados', norm(q));
    pintar();
  }

  // ---------- Eventos ----------
  let espera: number | undefined;
  input.addEventListener('input', () => {
    estado.q = input.value;
    clearTimeout(espera);
    espera = window.setTimeout(actualizarBusqueda, 180);
  });
  form.addEventListener('submit', (e) => { e.preventDefault(); estado.q = input.value; actualizarBusqueda(); input.blur(); });

  document.querySelectorAll<HTMLElement>('[data-faceta]').forEach((fs) => {
    const clave = fs.dataset.faceta as Clave;
    fs.addEventListener('change', (e) => {
      const cb = e.target as HTMLInputElement;
      if (cb.checked) estado.filtros[clave].add(cb.value);
      else estado.filtros[clave].delete(cb.value);
      registrar('filtrar', `${clave}/${cb.value}`);
      pintar();
    });
  });
  soloGuardados.addEventListener('change', () => { estado.guardados = soloGuardados.checked; pintar(); });

  document.querySelector<HTMLButtonElement>('[data-ver-mas]')?.addEventListener('click', (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const fs = b.closest('fieldset')!;
    const ocultos = fs.querySelectorAll<HTMLElement>('[data-extra]');
    const mostrar = [...ocultos].some((l) => l.hidden);
    ocultos.forEach((l) => { l.hidden = !mostrar; });
    b.textContent = mostrar ? 'Ver menos' : `Ver ${ocultos.length} más`;
  });

  botonesLimpiar.forEach((b) => b.addEventListener('click', () => {
    CLAVES.forEach((c) => estado.filtros[c].clear());
    estado.guardados = false;
    estado.q = ''; input.value = ''; coincidencias = null;
    pintar();
  }));

  // Panel de filtros: abierto en escritorio, plegado en celular
  const escritorio = window.matchMedia('(min-width: 900px)');
  const ajustarPanel = () => { panel.open = escritorio.matches; };
  escritorio.addEventListener('change', ajustarPanel);
  ajustarPanel();

  // ---------- Inicio ----------
  leerURL();
  input.value = estado.q;
  almacen.favoritos().then((uids) => {
    favoritos = new Set(uids);
    const n = tarjetas.filter((li) => favoritos.has(li.dataset.uid!)).length;
    if (n) {
      document.querySelector<HTMLElement>('[data-guardados-faceta]')!.hidden = false;
      document.querySelector<HTMLElement>('[data-cuenta-guardados]')!.textContent = String(n);
    }
    if (estado.q.trim()) actualizarBusqueda(); else pintar();
  });
</script>
