---
/* La exploración ahora vive en la portada. Esta página se conserva solo
   para que los enlaces antiguos a /explorar/ sigan funcionando. */
import { ruta } from '../lib/url';
const destino = ruta();
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Explorar</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={new URL(destino, Astro.site).href} />
  <script is:inline define:vars={{ destino }}>
    const p = new URLSearchParams(location.search);
    if (p.has('asignatura')) { p.set('seccion', p.get('asignatura')); p.delete('asignatura'); }
    location.replace(destino + (p.toString() ? '?' + p : ''));
  </script>
</head>
<body><p><a href={destino}>Ir al catálogo</a></p></body>
</html>
